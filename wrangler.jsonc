// Cloudflare Workers config. The Worker (worker/sites.js) serves this repo's files and decides which folder each
// address may see (worker/routes.js). No data and no secrets in this file: settings the Worker needs are set in the
// Cloudflare dashboard (keep_vars keeps them across deploys).
{
  "name": "residencyapps",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // every request goes through the Worker first (it picks the folder by address); it does the folder-index and
    // trailing-slash handling itself, so Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // no preview link per branch or build, and no *.workers.dev address: only the real addresses serve the apps
  "preview_urls": false,
  "workers_dev": false,
  "keep_vars": true,
  "routes": [{ "pattern": "residencyapps.anawj.com", "custom_domain": true }],
  // the passcode sign-in (worker/guest.js): at most 10 tries a minute per address
  "ratelimits": [{ "name": "GUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // the passcodes changed on the app's Set up page are read from Firestore (worker/guest.js). Both values are public (the web
  // API key is restricted by address; access is by the rules). FIREBASE_API_KEY is filled in when the Firebase project exists:
  // until then the Worker uses its passcode secrets only.
  "vars": { "FIREBASE_API_KEY": "", "FIREBASE_PROJECT": "residencyapps" }
}
